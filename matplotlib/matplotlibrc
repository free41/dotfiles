# Matplotlib configuration
# Works on Windows, WSL, Linux, and in virtual environments
# Set MPLCONFIGDIR environment variable to point to this directory

# Figure properties
figure.figsize: 4, 3.5
figure.dpi: 120
savefig.dpi: 600
savefig.format: png
savefig.transparent: True

# Font settings
font.size: 9
font.sans-serif: Century Gothic
axes.labelsize: large

# Tick direction (inset)
xtick.direction: in
ytick.direction: in
xtick.top: True
ytick.right: True

# Paul Tol's vibrant color scheme (colorblind-safe) + cycle through markers
# https://personal.sron.nl/~pault/
axes.prop_cycle: cycler('color', ['EE7733', '0077BB', '33BBEE', 'EE3377', 'CC3311', '009988', 'BBBBBB']) + cycler('marker', ['o', 's', '^', 'v', 'D', 'p', '*'])

# Default to markers only (no lines)
lines.linestyle: None
lines.markersize: 6

# Grid
axes.grid: False

# Legend
legend.frameon: False

# Axes
axes.linewidth: 1.2

